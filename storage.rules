rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ----- Database (file library — Internal / Developer / Lombok / Japan) -----
    // Anyone signed-in can read / list files (the team library is shared).
    // Anyone signed-in can upload (limit 50MB, common file types only).
    // Only the uploader OR admin can delete.
    match /database/{section}/{filename=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('application/.*')
            || request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('text/.*')
            || request.resource.contentType.matches('audio/.*'));
      allow delete: if request.auth != null
        && (request.auth.token.email in [
              'balraj@exceed-re.ae',
              'admin@exceed-re.ae'
            ]
            || resource.metadata.uploadedBy == request.auth.uid);
      // Updates are not used — re-upload as a new file instead.
      allow update: if false;
    }

    // ----- Profile pictures (one per user, optional) -----
    // Owner-only write; anyone signed-in can read (so teammates see avatars).
    match /profile-photos/{uid}/{filename=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ----- Payment attachments + signed PDFs -----
    // Any signed-in user can read (so the approver, requester, Mouad, Hira,
    // Teruo all see the same paperwork). Uploads accept invoices/receipts
    // (images, PDFs) at submission time and signed-PDF versions at approval
    // time. 20 MB cap; common document types only.
    match /payments/{paymentId}/{filename=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null
        && request.auth.token.email in [
              'balraj@exceed-re.ae',
              'admin@exceed-re.ae'
           ];
    }

    // Default — deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
